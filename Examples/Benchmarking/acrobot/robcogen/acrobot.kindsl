Robot Acrobot
{
/*
 * RobCoGen turns a revolute joint about its own z axis, applies gravity along the base's -z, and takes a
 * link's inertia about the link frame's origin. So the shoulder frame is the base turned 90 degrees about y,
 * each link lies along its +x axis, and Iy and Iz include m * d^2 (0.083 + 0.25 and 0.333 + 1.0).
 */

RobotBase base {
    inertia_properties {
        mass = 0.0
        CoM = (0.0, 0.0, 0.0)
        Ix=0.0  Iy=0.0  Iz=0.0  Ixy=0.0  Ixz=0.0  Iyz=0.0
    }
    children {
        link1 via shoulder
    }
}

link link1 {
    id = 1
    inertia_properties {
        mass = 1.0
        CoM = (0.5, 0.0, 0.0)
        Ix=0.001  Iy=0.333  Iz=0.333  Ixy=0.0  Ixz=0.0  Iyz=0.0
    }
    children {
        link2 via elbow
    }
}

link link2 {
    id = 2
    inertia_properties {
        mass = 1.0
        CoM = (1.0, 0.0, 0.0)
        Ix=0.001  Iy=1.333  Iz=1.333  Ixy=0.0  Ixz=0.0  Iyz=0.0
    }
    children {}
}

r_joint shoulder {
    ref_frame {
        translation = (0.0, 0.0, 0.0)
        rotation    = (0.0, PI/2.0, 0.0)
    }
}

r_joint elbow {
    ref_frame {
        translation = (1.0, 0.0, 0.0)
        rotation    = (0.0, 0.0, 0.0)
    }
}

}
